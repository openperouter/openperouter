log stdout 
log timestamp precision 3
hostname hostname
ip nht resolve-via-default
ipv6 nht resolve-via-default
vrf red
  vni 100
exit-vrf

route-map allowall permit 1

bgp community-list standard openpe-fabric permit 65432:10
route-map openpe-fabric-in permit 1
  set community 65432:10 additive
route-map openpe-fabric-out deny 1
  match community openpe-fabric
route-map openpe-fabric-out permit 2
  set comm-list openpe-fabric delete
route-map openpe-fabric-strip permit 1
  set comm-list openpe-fabric delete
router bgp 64512
  no bgp ebgp-requires-policy
  no bgp network import-check
  no bgp default ipv4-unicast
  bgp bestpath as-path multipath-relax
  bgp router-id 10.0.0.1
  neighbor eth1 interface remote-as 64512
  
  
  
  neighbor eth1 capability extended-nexthop

  address-family ipv4 unicast
    neighbor eth1 activate
    neighbor eth1 next-hop-self force
    neighbor eth1 route-map openpe-fabric-strip out
  exit-address-family
  address-family ipv4 unicast
    network 100.64.0.1/32
  exit-address-family

  address-family l2vpn evpn
    neighbor eth1 activate
    neighbor eth1 route-map openpe-fabric-strip out
    advertise-all-vni
  exit-address-family
exit
!
router bgp 64512 vrf red
  no bgp ebgp-requires-policy
  no bgp network import-check
  no bgp default ipv4-unicast
  bgp router-id 10.0.0.1
  
  neighbor 2001:db8::2 remote-as 64512

  address-family ipv4 unicast
    neighbor 2001:db8::2 activate
    neighbor 2001:db8::2 route-map allowall in
    neighbor 2001:db8::2 route-map openpe-fabric-strip out
    neighbor 2001:db8::2 next-hop-self force
  exit-address-family

  address-family ipv6 unicast
    network 2001:db8::2/64
    neighbor 2001:db8::2 activate
    neighbor 2001:db8::2 route-map allowall in
    neighbor 2001:db8::2 route-map openpe-fabric-strip out
    neighbor 2001:db8::2 next-hop-self force
  exit-address-family

  address-family l2vpn evpn
    advertise ipv4 unicast
    advertise ipv6 unicast
  exit-address-family
exit
