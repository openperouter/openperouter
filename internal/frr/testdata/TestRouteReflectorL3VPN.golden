log stdout 
log timestamp precision 3
hostname hostname
ip nht resolve-via-default
ipv6 nht resolve-via-default

route-map allowall permit 1

bgp community-list standard openpe-fabric permit 65432:10
route-map openpe-fabric-in permit 1
  set community 65432:10 additive
route-map openpe-fabric-out deny 1
  match community openpe-fabric
route-map openpe-fabric-out permit 2
  set comm-list openpe-fabric delete
route-map openpe-fabric-strip permit 1
  set comm-list openpe-fabric delete
router bgp 64514
  no bgp ebgp-requires-policy
  no bgp network import-check
  no bgp default ipv4-unicast
  bgp bestpath as-path multipath-relax
  bgp router-id 10.0.0.1
  bgp cluster-id 192.0.2.1

  bgp route-reflector allow-outbound-policy
  neighbor fc00::2:172:31:1:12 remote-as internal
  
  
  
  neighbor fc00::2:172:31:1:12 capability extended-nexthop
  neighbor fc00::2:172:31:1:12 update-source fc00::2:172:31:1:32

  address-family ipv4 vpn
    neighbor fc00::2:172:31:1:12 activate
    neighbor fc00::2:172:31:1:12 route-reflector-client
    neighbor fc00::2:172:31:1:12 route-map openpe-fabric-strip out
  exit-address-family
  !
  address-family ipv6 vpn
    neighbor fc00::2:172:31:1:12 activate
    neighbor fc00::2:172:31:1:12 route-reflector-client
    neighbor fc00::2:172:31:1:12 route-map openpe-fabric-strip out
  exit-address-family
  !
  segment-routing srv6
    encap-behavior H_Encaps
    locator MAIN
  exit
exit
!
segment-routing
  srv6
    encapsulation
      source-address fc00::2:172:31:1:32
    exit
    locators
      locator MAIN
        prefix fd00:0:32::/48 block-len 32 node-len 16
        behavior usid
        format usid-f3216
      exit
      !
    exit
    !
  exit
  !
exit
!
