log stdout 
log timestamp precision 3
hostname hostname
ip nht resolve-via-default
ipv6 nht resolve-via-default

route-map allowall permit 1

bgp community-list standard openpe-fabric permit 65432:10
route-map openpe-fabric-in permit 1
  set community 65432:10 additive
route-map openpe-fabric-out deny 1
  match community openpe-fabric
route-map openpe-fabric-out permit 2
  set comm-list openpe-fabric delete
route-map openpe-fabric-strip permit 1
  set comm-list openpe-fabric delete
router bgp 64512
  no bgp ebgp-requires-policy
  no bgp network import-check
  no bgp default ipv4-unicast
  bgp bestpath as-path multipath-relax
  bgp router-id 10.0.0.1
  address-family ipv4 unicast
    network 100.64.0.1/32
  exit-address-family

  address-family l2vpn evpn
    advertise-all-vni
    vni 100
      rd 10.0.0.1:500
    exit-vni
    vni 101
      rd 10.0.0.1:501
      route-target export 65000:101
      route-target import 65001:101
    exit-vni
    vni 102
      route-target export 65000:102
      route-target import 65001:102
    exit-vni
  exit-address-family
exit
!
