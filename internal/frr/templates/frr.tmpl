log stdout {{.Loglevel}}
log timestamp precision 3
{{- if eq .Loglevel "debug" }}
debug zebra events
debug zebra nht
debug zebra kernel
debug zebra rib
debug zebra nexthop
debug zebra dplane dpdk
debug bgp neighbor-events
debug bgp updates
debug bgp keepalives
debug bgp nht
debug bgp zebra
debug bgp neighbor
debug bgp graceful-restart
debug bfd network
debug bfd peer
debug bfd zebra
{{- end }}
hostname {{.Hostname}}
ip nht resolve-via-default
ipv6 nht resolve-via-default

{{- range .L3VNIs }}
vrf {{ .VRF }}
  vni {{ .VNI }}
exit-vrf
{{- end }}

{{- if .BFDProfiles }}
bfd
{{- range .BFDProfiles }}
{{- template "bfdprofile" dict "profile" . }}
{{- end }}
exit
{{- end }}

route-map allowall permit 1

{{- if .Underlay.MyASN }}
router bgp {{ .Underlay.MyASN }}
  no bgp ebgp-requires-policy
  no bgp network import-check
  no bgp default ipv4-unicast
  bgp router-id {{ .Underlay.RouterID }}
{{- if .Underlay.GracefulRestart }}
  bgp graceful-restart
  bgp graceful-restart preserve-fw-state
{{- /* 120 and 360 are FRR's defaults for restart-time and stalepath-time.
       Rendering them explicitly causes frr-reload.py to re-apply them on
       every reload (show running-config suppresses defaults), which resets
       all BGP sessions. https://github.com/FRRouting/frr/issues/22953 */ -}}
{{- if ne .Underlay.GracefulRestart.RestartTime 120 }}
  bgp graceful-restart restart-time {{ .Underlay.GracefulRestart.RestartTime }}
{{- end }}
{{- if ne .Underlay.GracefulRestart.StalePathTime 360 }}
  bgp graceful-restart stalepath-time {{ .Underlay.GracefulRestart.StalePathTime }}
{{- end }}
{{- end }}

{{- if .Underlay.RouteReflector }}
  bgp cluster-id {{ .Underlay.RouteReflector.ClusterID }}
{{- end }}
{{- if .Underlay.HasListenRange }}
{{- /* raises the FRR default dynamic neighbors cap (100), needed to
       properly support listen ranges since we don't know the amount of
       neighbors from the get go */}}
  bgp listen limit {{ .Underlay.BGPListenLimit }}
{{- end }}
{{- range $n := .Underlay.Neighbors }}
{{- template "neighborsession" dict
    "neighbor" $n
    "routerASN" $.Underlay.MyASN -}}
{{- end }}
{{- range $n := .Underlay.Neighbors }}
{{- template "neighborenableipfamily" dict
    "neighbor" $n
    "routerASN" $.Underlay.MyASN -}}
{{end }}

{{- if .Passthrough }}
{{- template "localpassthrough" . -}}
{{- end }}

{{- if renderUnderlayEVPN .Underlay }}
{{- template "underlayevpn" . -}}
{{- end }}
{{- if .Underlay.SegmentRouting }}
{{- template "underlayl3vpn" . -}}
{{- end }}
exit
!
{{- end }}

{{- range $n := .L3VNIs }}
{{- template "vni" dict
    "vni" $n
    "routerASN" $.Underlay.MyASN -}}
{{- end }}
{{- range $n := .VPNs }}
{{- template "vpn" dict
    "vpn" $n 
    "routerASN" $.Underlay.MyASN -}}
{{- end }}
{{- range .RawConfig }}
{{ .Config }}
{{- end }}

{{- if .Underlay.ISIS }}
{{- template "isis" dict "isisconf" $.Underlay.ISIS "segmentrouting" $.Underlay.SegmentRouting -}}
{{- end }}

{{- if .Underlay.SegmentRouting }}
{{- template "segmentrouting" .Underlay.SegmentRouting -}}
{{- end }}
