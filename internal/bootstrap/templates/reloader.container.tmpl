# Generated by /bootstrap. Do not edit: changes are overwritten at boot.
# OpenPERouter FRR Configuration Reloader.

[Unit]
Description=OpenPERouter FRR Reloader Container
Documentation=https://github.com/openperouter

[Quadlet]
DefaultDependencies=false

[Container]
Image={{ .Image }}
Pull=missing
Pod=routerpod.pod
ContainerName=reloader
Volume=frr-sockets.volume:/var/run/frr:Z
Volume=/etc/perouter/frr:/etc/perouter:Z
Entrypoint=/reloader
Exec=--frrconfig=/etc/perouter/frr.conf --loglevel={{ .LogLevel }} --unixsocket /etc/perouter/frr.socket
HealthCmd=wget -qO- http://127.0.0.1:9080/healthz || exit 1
HealthStartPeriod=120s
HealthInterval=20s
HealthTimeout=5s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=on-failure
TimeoutStopSec=70
