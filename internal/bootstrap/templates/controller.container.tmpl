# Generated by /bootstrap. Do not edit: changes are overwritten at boot.
# OpenPERouter Controller Container.

[Unit]
Description=OpenPERouter Controller Container
Documentation=https://github.com/openperouter

[Quadlet]
DefaultDependencies=false

[Container]
Image={{ .Image }}
Pull=missing
Pod=controllerpod.pod
ContainerName=controller
AddCapability=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
Network=host
Volume=/run/netns:/run/netns:rshared
Volume=/etc/perouter/frr:/etc/perouter/frr:rshared
Volume=/var/lib/hostbridge:/shared:rshared
Volume=/var/lib/openperouter:/etc/openperouter:ro
Volume={{ .RuntimeConfiguration.Directory }}:{{ .RuntimeConfigurationMountPath }}:ro
Volume=/proc:/hostproc:ro
Volume=/run/dbus/system_bus_socket:/host/dbus/system_bus_socket:rw
Volume={{ .OVSRunDir }}:{{ .OVSRunDir }}:rshared
Volume=/var/lib/openperouter/cni/cache:/var/lib/openperouter/cni/cache:rw
Environment=KUBECONFIG=/shared/kubeconfig
PodmanArgs=--privileged
PodmanArgs=--pid=host
PodmanArgs=--uts=host
Exec={{ .ControllerArgs }}
HealthCmd=wget -qO- http://127.0.0.1:{{ .HealthProbePort }}/healthz || exit 1
HealthInterval=20s
HealthTimeout=5s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=on-failure
TimeoutStopSec=70
ExecStartPre=/usr/bin/mkdir -p /etc/perouter/frr
ExecStartPre=/usr/bin/mkdir -p /var/lib/hostbridge
ExecStartPre=/usr/bin/mkdir -p /var/lib/openperouter
ExecStartPre=/usr/bin/mkdir -p {{ .OVSRunDir }}
ExecStartPre=/usr/bin/mkdir -p /var/lib/openperouter/cni/cache
# If a can_start.sh script is present, run it and wait for success.
ExecStartPre=/bin/sh -c 'f=/var/lib/openperouter/can_start.sh; [ ! -e "$f" ] || "$f"'
