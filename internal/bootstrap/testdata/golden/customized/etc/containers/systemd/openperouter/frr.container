# Generated by /bootstrap. Do not edit: changes are overwritten at boot.
# OpenPERouter FRR Container.

[Unit]
Description=OpenPERouter FRR Container
Documentation=https://github.com/openperouter

[Quadlet]
DefaultDependencies=false

[Container]
Image=quay.io/openperouter/router:v0.1.0
Pull=missing
Pod=routerpod.pod
ContainerName=frr
AddCapability=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN CAP_KILL
Environment=TINI_SUBREAPER=true
Volume=frr-sockets.volume:/var/run/frr:Z
Volume=/var/lib/openperouter/frr/daemons:/etc/frr/daemons:ro,z
PodmanArgs=--pidfile=/etc/perouter/frr/frr.pid
Entrypoint=/bin/bash
Exec=-c "chmod -R a+rw /var/run/frr && exec /sbin/tini -- /usr/lib/frr/docker-start"
HealthCmd=wget -qO- http://127.0.0.1:9080/healthz || exit 1
HealthStartPeriod=120s
HealthInterval=20s
HealthTimeout=10s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=on-failure
TimeoutStopSec=70
ExecStartPre=/usr/bin/mkdir -p /etc/perouter/frr
