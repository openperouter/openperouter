! EVPN split-horizon fixture: peer only with OpenPE, advertise VTEP reachability,
! and export leafkind1's connected prefix from the permanent sh-evpn VRF as type 5.
! setup.sh provisions the VRF/L3VNI; spine BGP and ISIS stay disabled.
!
log file /etc/frr/frr.log debug
ipv6 forwarding
!
vrf sh-evpn
 vni 4091
exit-vrf
!
router bgp {{ .ASN }}
 bgp router-id {{ .RouterID }}
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
 no bgp network import-check
{{- range .Neighbors }}
 neighbor {{ .ID }} remote-as {{ $.PERouterASN }}
 neighbor {{ .ID }} timers connect 5
{{- end }}
 !
 address-family ipv4 unicast
  network {{ .VTEPIP }}/32
{{- range .Neighbors }}
  neighbor {{ .ID }} activate
{{- end }}
 exit-address-family
 !
 address-family l2vpn evpn
{{- range .Neighbors }}
  neighbor {{ .ID }} activate
{{- end }}
  advertise-all-vni
 exit-address-family
exit
!
router bgp {{ .ASN }} vrf sh-evpn
 bgp router-id {{ .RouterID }}
 address-family ipv4 unicast
{{- $familyKey := safiAFIKey "ipv4" "unicast" }}
{{- $prefixes := index .Networks $familyKey }}
{{- range $prefix := $prefixes }}
  network {{ $prefix }}
{{- end }}
 exit-address-family
 !
 address-family l2vpn evpn
  advertise ipv4 unicast
 exit-address-family
exit
!
interface eth1
exit
!
interface {{ .ToSwitchInterface }}
exit
!
