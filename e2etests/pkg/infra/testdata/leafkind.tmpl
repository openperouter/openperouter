log file /etc/frr/frr.log debug
ipv6 forwarding

debug zebra events
debug zebra vxlan
debug zebra nht
debug zebra kernel
debug zebra rib
debug zebra nexthop
debug bgp neighbor-events
debug bgp updates
debug bgp keepalives
debug bgp nht
debug bgp zebra
debug bgp neighbor
debug bgp graceful-restart
debug bfd network
debug bfd peer
debug bfd zebra

router bgp {{ .ASN }}
 bgp graceful-restart
 bgp graceful-restart preserve-fw-state
 no bgp ebgp-requires-policy
 no bgp network import-check
 no bgp default ipv4-unicast

{{- if not .DisableSpinePeer }}
 neighbor {{ .SpinePeerAddress }} remote-as 64612
{{- end }}

{{- range .Neighbors }}
{{- if .IsInterface }}
 neighbor {{ .ID }} interface remote-as {{ $.PERouterASN }}
{{- else }}
 neighbor {{ .ID }} remote-as {{ $.PERouterASN }}
{{- end }}
 neighbor {{ .ID }} timers connect 5
{{- if .Password }}
 neighbor {{ .ID }} password {{ .Password }}
{{- end }}
{{- if $.EnableBFD }}
 neighbor {{ .ID }} bfd
{{- end }}
{{- end }}

 !
{{- range $af := .BGPAddressFamilies }}
 address-family {{ $af.AFI }} {{ $af.SAFI }}
{{- range index $.Networks (printf "%s %s" $af.AFI $af.SAFI) }}
  network {{ . }}
{{- end }}
{{- if $.RedistributeConnected }}
  redistribute connected
{{- end }}
{{- if not $.DisableSpinePeer }}
  neighbor {{ $.SpinePeerAddress }} activate
{{- end }}
{{- range $.Neighbors }}
  neighbor {{ .ID }} activate
{{- if $.NextHopSelf }}
  neighbor {{ .ID }} next-hop-self force 
{{- end }}
{{- end }}
 exit-address-family
{{- end }}
 !
 address-family l2vpn evpn
{{- if not $.DisableSpinePeer }}
  neighbor {{ .SpinePeerAddress }} activate
{{- end }}
{{- range .Neighbors }}
  neighbor {{ .ID }} activate
{{- end }}
{{- range .EVPNNetworks }}
  network {{ .Prefix }} rd {{ .RD }} ethtag {{ .EthernetTag }} label {{ .Label }} esi {{ .ESI }} gwip 0.0.0.0 routermac {{ .RouterMAC }}
{{- end }}
  advertise-all-vni
  advertise-svi-ip
 exit-address-family
exit
! 
{{- if not .DisableISIS }}
router isis ISIS
  is-type level-1
  advertise-passive-only
  net {{ .ISISNet }}
exit
!
{{- end }}
interface eth1
{{- if not .DisableISIS }}
  ipv6 router isis ISIS
{{- end }}
exit
!
interface {{ .ToSwitchInterface }}
{{- if not .DisableISIS }}
  ipv6 router isis ISIS
{{- end }}
exit
!
